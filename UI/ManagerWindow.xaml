<Window x:Class="Paster.UI.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Paster.UI"
        Title="Paster — snippets" Width="940" Height="620"
        MinWidth="680" MinHeight="420"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="paster.ico">

    <Window.Resources>
        <ui:IndexKeyConverter x:Key="IndexKey" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- list toolbar -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Add" Click="OnAdd" ToolTip="New snippet (Ctrl+N)" />
            <Button Content="Duplicate" Click="OnDuplicate" Margin="6,0,0,0" />
            <Button Content="Delete" Click="OnDelete" Margin="6,0,0,0"
                    Foreground="{StaticResource Danger}" />
            <Button Content="↑" Click="OnMoveUp" Margin="12,0,0,0" ToolTip="Move up (Alt+Up)" />
            <Button Content="↓" Click="OnMoveDown" Margin="6,0,0,0" ToolTip="Move down (Alt+Down)" />
        </StackPanel>

        <ListBox x:Name="List" Grid.Row="1" ItemsSource="{Binding Items}"
                 SelectionChanged="OnSelectionChanged" AlternationCount="1000">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource TextFaint}"
                                   Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource IndexKey}}"
                                   FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <!-- editor toolbar -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Insert {{cursor}}" Click="OnInsertCursor"
                    ToolTip="Caret is left here after pasting" />
            <Button Content="Insert {{select:…}}" Click="OnInsertSelect" Margin="6,0,0,0"
                    ToolTip="Pasted text is left selected, ready to type over" />
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="2" x:Name="Editor">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="NameBox" Margin="0,0,0,8" FontSize="14"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox x:Name="BodyBox" Grid.Row="1"
                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     FontFamily="{StaticResource MonoFont}" FontSize="13"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="False" />
        </Grid>

        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="NoSelection"
                   Text="Select a snippet on the left, or add one."
                   Style="{StaticResource Hint}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- status bar -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PathLabel" Style="{StaticResource Hint}"
                           TextTrimming="CharacterEllipsis" Cursor="Hand"
                           MouseLeftButtonUp="OnOpenFolder"
                           ToolTip="Click to open this folder in Explorer" />
                <TextBlock x:Name="HotkeyLabel" Style="{StaticResource Hint}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="DirtyLabel" Text="unsaved changes"
                           Foreground="{StaticResource Danger}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="Collapsed" />
                <Button Content="Reload from file" Click="OnReload" />
                <Button Content="Save" Click="OnSave" Margin="6,0,0,0" MinWidth="80"
                        Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}"
                        ToolTip="Ctrl+S" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
