<Window x:Class="Paster.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Opacity="0"
        ShowActivated="False"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="10" Width="520" Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270"
                              Color="#000000" Opacity="0.55" />
        </Border.Effect>

        <StackPanel>
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0"
                     MaxHeight="430" Margin="4,8,4,4"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewMouseLeftButtonUp="OnListClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{StaticResource BgElevated}" CornerRadius="4"
                                    Width="20" Height="20" VerticalAlignment="Top"
                                    Visibility="{Binding KeyVisibility}">
                                <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Preview}" Foreground="{StaticResource TextFaint}"
                                           FontSize="11" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="&#x2316;" FontSize="14" VerticalAlignment="Top"
                                       Foreground="{StaticResource Accent}"
                                       ToolTip="Moves the caret after pasting"
                                       Visibility="{Binding PlaceholderVisibility}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Height="1" Background="{StaticResource Border}" Opacity="0.7" />

            <TextBlock Text="1-9,0 paste &#183; &#8593;&#8595; Enter &#183; Esc closes"
                       Foreground="{StaticResource TextFaint}" FontSize="11"
                       Margin="14,7,14,9" />
        </StackPanel>
    </Border>
</Window>
